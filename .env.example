# Configuration for the end-to-end suite (`mix test --only e2e`), the seed
# (`mix castor_edc.e2e.seed`) and fixture recording (`mix castor_edc.fixtures.record`).
# Copy to .env, fill in, and load it into your shell; .env isn't committed.
CASTOR_EDC_CLIENT_ID=
CASTOR_EDC_CLIENT_SECRET=
# A test study: the suite writes participants, data points and exports to it.
CASTOR_EDC_STUDY_ID=
# Optional, https://data.castoredc.com by default.
CASTOR_EDC_BASE_URL=
